FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
ARG DOSEMU_VERSION=2.0~pre9-10384-36b60dc82+202610161503~ubuntu24.04.1
ARG FDPP_VERSION=1.10-10002-1671-9282d8c+202605091902~ubuntu24.04.1
ARG LIBFDPP_VERSION=1.11-10003-1716-2f10d8a+202610122230~ubuntu24.04.1
ARG COMCOM_VERSION=0.5-0~202610040914+202610161046~ubuntu24.04.1
ADD --checksum=sha256:3c9cbc002c9f90a9afdaf582e7a73a530faaa233b3b8918a1caaf20b7676dbb3 https://launchpad.net/~dosemu2/+archive/ubuntu/ppa/+build/33849543/+files/dosemu2_2.0~pre9-10384-36b60dc82+202610161503~ubuntu24.04.1_amd64.deb /tmp/dosemu2.deb
COPY vendor/lord/lord402.zip /tmp/lord402.zip
COPY assets/doors/dosemurc /tmp/lord-dosemurc
COPY assets/doors/marslord.bat /tmp/marslord.bat
COPY --chown=21011:21011 --chmod=0400 vendor/lord/registration.txt /usr/share/mars-doors/lord-registration.txt
RUN echo "52c0272b691dd3a4fd1294abc40115bf8a22f8c8ce4550c92d392212b6e381c0  /tmp/lord402.zip" | sha256sum -c - && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 libsodium23 ca-certificates tzdata software-properties-common bubblewrap frotz unzip && add-apt-repository -y ppa:dosemu2/ppa && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends /tmp/dosemu2.deb fdpp="$FDPP_VERSION" libfdpp35="$LIBFDPP_VERSION" comcom64="$COMCOM_VERSION" && test "$(dpkg-query -W -f='${Version}' dosemu2)" = "$DOSEMU_VERSION" && install -d /tmp/lord-outer /opt/mars-doors/templates/lord/home/.dosemu/drive_c/doors/lord && unzip -q /tmp/lord402.zip LORD.ZIP -d /tmp/lord-outer && unzip -q /tmp/lord-outer/LORD.ZIP -d /opt/mars-doors/templates/lord/home/.dosemu/drive_c/doors/lord && install -m 0444 /tmp/lord-dosemurc /opt/mars-doors/templates/lord/home/.dosemu/dosemurc && install -m 0444 /tmp/marslord.bat /opt/mars-doors/templates/lord/home/.dosemu/drive_c/doors/lord/marslord.bat && rm -f /tmp/dosemu2.deb /tmp/lord402.zip /tmp/lord-dosemurc /tmp/marslord.bat && rm -rf /tmp/lord-outer && DEBIAN_FRONTEND=noninteractive apt-get purge -y software-properties-common unzip && DEBIAN_FRONTEND=noninteractive apt-get autoremove -y --purge && rm -rf /var/lib/apt/lists/* && ln -s /usr/games/dfrotz /usr/local/bin/dfrotz && groupadd --gid 21011 mars-door && useradd --uid 21011 --gid 21011 --home-dir /nonexistent --shell /usr/sbin/nologin mars-door && install -d -o 21011 -g 21011 -m 0700 /var/lib/mars-v2/door && install -d -o 21011 -g 21011 -m 0755 /run/mars-v2/door && find / -xdev -type f -perm /6000 -exec chmod a-s {} +
RUN chmod 0555 /usr/share/mars-doors
ENV PYTHONPATH=/opt/mars-v2 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MARS_V2_HEALTH_SERVICE=door
WORKDIR /opt/mars-v2
COPY marsv2/ marsv2/
RUN find /opt/mars-v2 /opt/mars-doors -type d -exec chmod 0555 {} + && find /opt/mars-v2 /opt/mars-doors -type f -exec chmod 0444 {} +
USER 21011:21011
ENTRYPOINT ["python3","-m","marsv2.doord"]
