FROM ubuntu:24.04@sha256:68ee22004a9109b44973313b02ff7b1de250f1de0f5ecb628d73f579aaff33ac
ARG DOSEMU_VERSION=2.0~pre9-10384-36b60dc82+202610161503~ubuntu24.04.1
ARG FDPP_VERSION=1.10-10002-1671-9282d8c+202605091902~ubuntu24.04.1
ARG LIBFDPP_VERSION=1.11-10003-1716-2f10d8a+202610122230~ubuntu24.04.1
ARG COMCOM_VERSION=0.5-0~202610040914+202610161046~ubuntu24.04.1
ADD --checksum=sha256:3c9cbc002c9f90a9afdaf582e7a73a530faaa233b3b8918a1caaf20b7676dbb3 https://launchpad.net/~dosemu2/+archive/ubuntu/ppa/+build/33849543/+files/dosemu2_2.0~pre9-10384-36b60dc82+202610161503~ubuntu24.04.1_amd64.deb /tmp/dosemu2.deb
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3 libsodium23 ca-certificates tzdata software-properties-common bubblewrap frotz && add-apt-repository -y ppa:dosemu2/ppa && apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends /tmp/dosemu2.deb fdpp="$FDPP_VERSION" libfdpp35="$LIBFDPP_VERSION" comcom64="$COMCOM_VERSION" && test "$(dpkg-query -W -f='${Version}' dosemu2)" = "$DOSEMU_VERSION" && rm -f /tmp/dosemu2.deb && DEBIAN_FRONTEND=noninteractive apt-get purge -y software-properties-common && DEBIAN_FRONTEND=noninteractive apt-get autoremove -y --purge && rm -rf /var/lib/apt/lists/* && ln -s /usr/games/dfrotz /usr/local/bin/dfrotz && groupadd --gid 21011 mars-door && useradd --uid 21011 --gid 21011 --home-dir /nonexistent --shell /usr/sbin/nologin mars-door && install -d -o 21011 -g 21011 -m 0700 /var/lib/mars-v2/door && install -d -o 21011 -g 21011 -m 0755 /run/mars-v2/door && find / -xdev -type f -perm /6000 -exec chmod a-s {} +
ENV PYTHONPATH=/opt/mars-v2 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MARS_V2_HEALTH_SERVICE=door
WORKDIR /opt/mars-v2
COPY marsv2/ marsv2/
RUN find /opt/mars-v2 -type d -exec chmod 0555 {} + && find /opt/mars-v2 -type f -exec chmod 0444 {} +
USER 21011:21011
ENTRYPOINT ["python3","-m","marsv2.doord"]
